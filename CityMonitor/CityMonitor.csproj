<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>

		<AssemblyName>CityMonitor</AssemblyName>
		<RootNamespace>CityMonitor</RootNamespace>

		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>

		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>

		<UIProjectDirectory>$(MSBuildProjectDirectory)\Frontend</UIProjectDirectory>
		<EnableCityMonitorUIBuild Condition="'$(EnableCityMonitorUIBuild)' == ''">true</EnableCityMonitorUIBuild>

		<DefaultItemExcludes>Frontend\node_modules\**;$(DefaultItemExcludes)</DefaultItemExcludes>
		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
	</PropertyGroup>

	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<ItemGroup>
		<Reference Include="Game"><Private>false</Private></Reference>
		<Reference Include="Colossal.Core"><Private>false</Private></Reference>
		<Reference Include="Colossal.Logging"><Private>false</Private></Reference>
		<Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
		<Reference Include="Colossal.UI"><Private>false</Private></Reference>
		<Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
		<Reference Include="Colossal.Localization"><Private>false</Private></Reference>
		<Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
		<Reference Include="Unity.Burst"><Private>false</Private></Reference>
		<Reference Include="Unity.Collections"><Private>false</Private></Reference>
		<Reference Include="Unity.Entities"><Private>false</Private></Reference>
		<Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System"><Private>false</Private></Reference>
		<Reference Update="System.Core"><Private>false</Private></Reference>
		<Reference Update="System.Data"><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

	<ItemGroup>
		<UpToDateCheckInput
			Include="Frontend\src\**\*.ts;Frontend\src\**\*.tsx;Frontend\src\**\*.css;Frontend\src\**\*.scss;Frontend\src\**\*.png;Frontend\src\**\*.jpg;Frontend\src\**\*.jpeg;Frontend\src\**\*.gif;Frontend\src\**\*.svg"
			Exclude="Frontend\node_modules\**" />
		<UpToDateCheckInput Include="Frontend\types\**\*.ts" />
		<UpToDateCheckInput Include="Frontend\tools\**\*.js" />
		<UpToDateCheckInput Include="Frontend\mod.json" />
		<UpToDateCheckInput Include="Frontend\package.json" />
		<UpToDateCheckInput Include="Frontend\package-lock.json" />
		<UpToDateCheckInput Include="Frontend\tsconfig.json" />
		<UpToDateCheckInput Include="Frontend\webpack.config.js" />
	</ItemGroup>

	<Target
		Name="RestoreCityMonitorUI"
		Condition="'$(EnableCityMonitorUIBuild)' == 'true'"
		Inputs="$(UIProjectDirectory)\package.json;$(UIProjectDirectory)\package-lock.json"
		Outputs="$(UIProjectDirectory)\node_modules\.city-monitor-restored">

		<Message Text="Restoring City Monitor frontend dependencies..." Importance="high" />

		<Exec
			Command="npm install --no-audit --no-fund"
			WorkingDirectory="$(UIProjectDirectory)"
			ConsoleToMSBuild="true"
			StandardOutputImportance="high"
			StandardErrorImportance="high" />

		<Touch
			Files="$(UIProjectDirectory)\node_modules\.city-monitor-restored"
			AlwaysCreate="true" />
	</Target>

	<Target
		Name="BuildCityMonitorUI"
		AfterTargets="AfterBuild"
		DependsOnTargets="RestoreCityMonitorUI"
		Condition="'$(EnableCityMonitorUIBuild)' == 'true'">

		<Message Text="Building City Monitor frontend..." Importance="high" />

		<Exec
			Command="npm run build"
			WorkingDirectory="$(UIProjectDirectory)"
			ConsoleToMSBuild="true"
			StandardOutputImportance="high"
			StandardErrorImportance="high" />
	</Target>

</Project>
